{
    "name": "jorrenh/laravel-pdf-merger",
    "type": "library",
    "description": "Package for Laravel that merges multiple PDFs into one.",
    "keywords": [
      "grofgraf",
      "jorrenh",
      "laravel",
      "pdf",
      "merger",
      "pdfmerger",
      "pdf-merger"
    ],
    "license": "MIT",
    "authors": [
      {
        "name": "Grof Graf"
      },
      {
        "name": "Jorren Hendriks"
      }
    ],
    "require": {
      "php": ">=8.0",
      "illuminate/filesystem": ">=9.0",
      "illuminate/support": ">=9.0",
      "setasign/fpdf": "1.8.*",
      "setasign/fpdi": "^2.0"
    },
    "autoload": {
      "psr-4": {
          "JorrenH\\LaravelPDFMerger\\": "src"
      }
    },
    "extra": {
      "laravel": {
        "providers": [
          "JorrenH\\LaravelPDFMerger\\Providers\\PDFMergerServiceProvider"
        ],
        "aliases": {
          "PDFMerger": "JorrenH\\LaravelPDFMerger\\Facades\\PDFMergerFacade"
        }
      }
    }
}
